@startuml

class PlayState {

}

class LevelGenerator {
    -macroGrid[MAP_ROOMS_Y][MAP_ROOMS_X] : RoomRole
    -roomVariations[MAP_ROOMS_Y][MAP_ROOMS_X] : int
    -generateMacroGrid() : void
    -obtainNewDirection(currX : int, movingLeft : bool&) : void
    -placeShop() : void
    -selectVariation(role : RoomRole, isEntrance : bool, zone : ZoneType) : int
    -instantiateTiles(zone : ZoneType, gx : int, gy : int, role : RoomRole, map : TileMap*) : void
    -instantiateLakeRoom(gx : int, gy : int, map : TileMap*, lType : LiquidType) : void
    -populateEntities(gx : int, gy : int, role : RoomRole, map : TileMap*) : void
    -validateLevel(map : TileMap*, start : Vector2i, exit : Vector2i) : bool
    -bfsReachability(map : TileMap*, from : Vector2i, to : Vector2i) : bool
    -getDifficultyConfig(floor : int) : DifficultyConfig
    -rollFloorModifier(floor : int) : FloorModifier
    +generate(floor : int, zone : ZoneType) : GeneratedLevel
}

class GeneratedLevel <<struct>> {
    +tileMap : unique_ptr<TileMap>
    +dynamicEntities : vector<unique_ptr<DynamicEntity>>
    +items : vector<unique_ptr<Item>>
    +traps : vector<unique_ptr<Trap>>
    +playerSpawn : Vector2
    +exitPos : Vector2
    +difficulty : DifficultyConfig
    +modifier : FloorModifier
    +initialLiquids : vector<LiquidSpawn>
    +shopArea : Rectangle
}

class DifficultyConfig <<struct>> {
    +ghostTimerSeconds : float
    +treasureValueMultiplier : int
}

class FloorModifier <<enumeration>> {
    NONE
    DARK_FLOOR
    FLOODED_FLOOR
    CURSED_FLOOR
}

class RoomRole <<enumeration>> {
    UNKNOWN
    TYPE_0
    TYPE_1
    TYPE_2
    TYPE_3
    TYPE_2_DROP_THROUGH
    TYPE_SHOP
}

class ZoneType <<enumeration>> {
    CAVE
    JUNGLE
    TEMPLE
}

class TileType <<enumeration>> {
    NOTHING
    CAVE_ROCK
    CAVE_REGULAR
    ... (80+ types omitted)
    LAVA
    WATER
}

class TileMap {
    -tiles : vector<vector<TileType>>
    -width : int
    -height : int
    -tileSize : int
    -currentZone : ZoneType
    +getTile(x : int, y : int) : TileType
    +setTile(x : int, y : int, type : TileType) : void
    +destroyBlock(x : int, y : int) : void
    +isSolid(x : int, y : int) : bool
    +isOneWayPlatform(x : int, y : int) : bool
    +isOpaque(x : int, y : int) : bool
    +isCracked(x : int, y : int) : bool
    +isLadder(x : int, y : int) : bool
    +render(cam : Camera2D&, lightMap : const vector<vector<Vector3>>&, foregroundPass : bool) : void
    +renderParallaxBackground(cam : Camera2D&) : void
}

PlayState *-- LevelGenerator : tempGenerator
PlayState *-- GeneratedLevel : tempLevel
LevelGenerator ..> GeneratedLevel : creates
LevelGenerator *-- RoomRole : macroGrid
LevelGenerator ..> ZoneType : uses
GeneratedLevel *-- TileMap : tileMap
GeneratedLevel *-- DifficultyConfig : difficulty
GeneratedLevel *-- FloorModifier : modifier
TileMap *-- ZoneType : currentZone
TileMap *-- TileType : tiles

@enduml